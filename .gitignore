# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.log

# AccessAI runtime data (keep folder structure via .gitkeep files)
data/*
!data/known_faces/
!data/history/
data/known_faces/*
!data/known_faces/.gitkeep
data/history/*
!data/history/.gitkeep

# Secrets (Phase 6: GitHub Models API keys). Keep .env.example, ignore .env.
.env
!.env.example

# Databases
*.db

# Model caches (downloaded at runtime by later phases)
*.onnx
*.pt
.insightface/
~/.insightface/

# Wake-word training cache (synthesized WAVs; regenerate with scripts/train_wakeword.py)
models/wakeword/_train_cache/

# Ultralytics' own settings/cache dir (created next to the CWD on first YOLO use)
Ultralytics/

# Pytest cache
.pytest_cache/

# Archived pre-restart build (local only)
_archive/

# OS / editor
.DS_Store
.idea/
.vscode/
